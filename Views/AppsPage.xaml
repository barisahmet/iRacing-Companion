<UserControl x:Class="IRacingSmartPlug.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:IRacingSmartPlug.ViewModels"
             xmlns:beh="clr-namespace:IRacingSmartPlug.Behaviors"
             d:DataContext="{d:DesignInstance vm:AppsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <Grid Margin="20,6,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="2,8,0,14">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Apps" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
        <TextBlock Text="Launch companion apps automatically with iRacing"
                   Style="{StaticResource PageSubtitle}" />
      </StackPanel>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary"
                 AutomationProperties.Name="AddAppButton" Command="{Binding AddAppCommand}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Add24" FontSize="16" />
          <TextBlock Text="Add app" Margin="8,0,2,0" />
        </StackPanel>
      </ui:Button>
    </Grid>

    <!-- App list -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,0,2">
      <StackPanel>
        <!-- Empty state -->
        <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="30" Margin="0,20,0,0">
          <StackPanel HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="AppsAddIn24" FontSize="30"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            <TextBlock Text="No companion apps yet" FontSize="15" FontWeight="SemiBold"
                       Margin="0,12,0,2" HorizontalAlignment="Center" />
            <TextBlock Text="Add Sound Shift, JoyToKey, RaceLab, or anything else."
                       Style="{StaticResource CardCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
              <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                  <StackPanel>
                    <!-- ===== Header row (click anywhere to expand/collapse) ===== -->
                    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Header_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!-- on/off switch on the left -->
                      <ui:ToggleSwitch Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"
                                       IsChecked="{Binding Enabled, Mode=TwoWay}" />

                      <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                  Opacity="{Binding Enabled, Converter={StaticResource EnabledOpacity}}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TagsText}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{Binding PathText}" FontSize="12" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </StackPanel>

                      <!-- chevron top-right; Launch + Delete below (delete rightmost, red on hover) -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Opacity="{Binding Enabled, Converter={StaticResource EnabledOpacity}}">
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                   BorderThickness="0" Background="Transparent" Padding="6" Margin="0,-6,-8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="ExpandButton"
                                   Command="{Binding ToggleEditCommand}" ToolTip="Expand / collapse">
                          <Grid>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="16"
                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="16"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                          </Grid>
                        </ui:Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                          <ui:Button Content="Launch" Appearance="Secondary" MinWidth="78"
                                     Command="{Binding LaunchCommand}" />
                          <ui:Button Appearance="Transparent" BorderThickness="0" Background="Transparent"
                                     Padding="9" Margin="8,0,0,0"
                                     Command="{Binding RemoveCommand}" ToolTip="Remove">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16">
                              <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                          </ui:Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>

                    <!-- ===== Inline editor (animated expand/collapse) ===== -->
                    <StackPanel beh:ExpandBehavior.IsOpen="{Binding IsEditing}"
                                Visibility="Collapsed" ClipToBounds="True" Margin="0">
                      <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                              Margin="0,15,0,16" />

                      <TextBlock Text="Name" Style="{StaticResource FieldCaption}" />
                      <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,12" />

                      <TextBlock Text="Executable" Style="{StaticResource FieldCaption}" />
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Path to the .exe" />
                        <ui:Button Grid.Column="1" Content="Browse…" Appearance="Secondary"
                                   Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                      </Grid>

                      <TextBlock Text="Arguments" Style="{StaticResource FieldCaption}" />
                      <ui:TextBox Text="{Binding EditArguments, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,12"
                                  PlaceholderText="Optional — e.g. a layout / profile the app accepts" />

                      <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Process name" Style="{StaticResource FieldCaption}" />
                          <ui:TextBox Text="{Binding EditProcessName, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="Auto from file" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Launch when" Style="{StaticResource FieldCaption}" />
                          <ComboBox ItemsSource="{Binding Triggers}" DisplayMemberPath="Display"
                                    SelectedValuePath="Value" HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding EditTrigger, Mode=TwoWay}" />
                        </StackPanel>
                      </Grid>

                      <CheckBox Content="Start minimized" Margin="0,0,0,2"
                                IsChecked="{Binding EditStartMinimized, Mode=TwoWay}" />

                      <TextBlock Text="{Binding EditError}"
                                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                 Margin="0,8,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding EditError, Converter={StaticResource StringToVis}}" />

                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0"
                                   Command="{Binding CancelCommand}" />
                        <ui:Button Content="Save" Appearance="Primary" MinWidth="80"
                                   Command="{Binding SaveCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Note -->
    <TextBlock Grid.Row="2" Text="{Binding Note}" Margin="2,10,0,0" FontSize="12.5"
               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
  </Grid>
</UserControl>
